# FPGA Agent - Environment Variable Configuration Template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored and will NEVER be committed. Do not put real API keys
# in any other file. The agent reads keys from environment variables only.
#
# This file documents ALL environment variables the agent recognizes.
# See also: agent/deepseek_client.py (the client that reads them).

# ============================================================================
# 1. LLM API Key (REQUIRED for --backend deepseek)
# ============================================================================
# The primary API key. The client checks LLM_API_KEY first, then falls back to
# DEEPSEEK_API_KEY for backward compatibility.

# Generic key (works for any OpenAI-compatible endpoint):
# export LLM_API_KEY=sk-your-api-key-here

# DeepSeek native key (fallback when LLM_API_KEY is unset):
export DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ============================================================================
# 2. LLM Model Endpoint & ID (for non-DeepSeek models)
# ============================================================================
# These override the DeepSeek defaults so the SAME client can talk to any
# OpenAI-compatible MaaS endpoint (e.g., Aliyun MaaS for Qwen models).
# Leave unset to use DeepSeek's native endpoint.

# Chat completions endpoint URL:
#   DeepSeek default: https://api.deepseek.com/v1/chat/completions
#   Aliyun MaaS:      https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# export LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions

# Model identifier (what the API expects in the "model" field):
#   DeepSeek V4 Pro:  deepseek-v4-pro
#   Qwen3.5 122B:     qwen3.5-122b-a10b
#   Qwen3.6 27B:      qwen3.6-27b
# export LLM_MODEL=deepseek-v4-pro

# ============================================================================
# 3. LLM Thinking / Reasoning Mode
# ============================================================================
# Controls how the "thinking" field is sent in the API request.
#   deepseek       - send {"thinking": {"type": "enabled", ...}} (default)
#   enable_thinking - send {"enable_thinking": true/false} (Qwen-style MaaS)
#   none           - omit the field entirely (some providers reject unknowns)
# export LLM_THINKING=deepseek

# ============================================================================
# 4. Optional Tuning
# ============================================================================
# Sampling temperature (default 0.2):
# export LLM_TEMPERATURE=0.2

# Request timeout in seconds (default 300; use 600 for slow 100B+ models):
# export LLM_TIMEOUT=300

# Transient-failure retries per call (default 3):
# export LLM_MAX_RETRIES=3

# Retry backoff base seconds (default 10; delay = base * 2**attempt, cap 120s):
# export LLM_RETRY_BASE_DELAY=10

# ============================================================================
# 5. Vitis HLS Location (Docker / non-standard installs)
# ============================================================================
# Path to the Vitis 2025.2 install containing settings64.sh.
# The harness uses this to locate the toolchain. In Docker, it is set by the
# Dockerfile; on bare metal, run.sh sets it automatically.
# export LLM4HLS_VITIS_HLS_ROOT=/home/admin/Xilinx/2025.2/Vitis

# ============================================================================
# Quick-start examples (uncomment and edit one block)
# ============================================================================

# --- DeepSeek V4 Pro (native) ---
# export DEEPSEEK_API_KEY=sk-your-key
# (LLM_BASE_URL and LLM_MODEL use DeepSeek defaults automatically)

# --- Qwen3.5 122B via Aliyun MaaS ---
# export LLM_API_KEY=sk-your-aliyun-key
# export LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# export LLM_MODEL=qwen3.5-122b-a10b
# export LLM_THINKING=enable_thinking
# export LLM_TIMEOUT=600

# --- Qwen3.6 27B via Aliyun MaaS ---
# export LLM_API_KEY=sk-your-aliyun-key
# export LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# export LLM_MODEL=qwen3.6-27b
# export LLM_THINKING=enable_thinking
